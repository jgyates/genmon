{
    "buttons":[
         {
            "information": "This file is used for the buttons on an Power Zone 200 controller",
            "onewordcommand" : "pzremotestop",
            "title" : "Stop Generator",
            "tooltip": "Stop and existing remote start command.",
            "command_sequence" : [
                                 {
                                    "reg": "0003",
                                    "value": "001a"
                                 }
                                 ]
         },
         {
            "onewordcommand" : "pzremoteexercise",
            "title" : "Start Exercise Cycle",
            "tooltip": "Start the generator internal exercise cycle.",
            "command_sequence" : [
                                 {
                                    "reg": "0003",
                                    "value": "001b"
                                 }
                                 ]
         },
         {
            "onewordcommand" : "pzauto",
            "title" : "Select Auto Mode",
            "tooltip": "Put the generator in Auto mode.",
            "command_sequence" : [
                                 {
                                    "reg": "0003",
                                    "value": "000f"
                                 }
                                 ]
         },
         {
            "onewordcommand" : "pzmanual",
            "title" : "Select Manual Mode",
            "tooltip": "Put the generator in Manual mode.",
            "command_sequence" : [
                                 {
                                    "reg": "0003",
                                    "value": "000e"
                                 }
                                 ]
         },
         {
            "onewordcommand" : "pzoff",
            "tooltip": "Put the generator in Off mode.",
            "title" : "Select Off Mode",
            "command_sequence" : [
                                 {
                                    "reg": "0003",
                                    "value": "0010"
                                 }
                                 ]
         },
         {
            "onewordcommand" : "pzremotestarttransfer",
            "title" : "Alternate Remote Start and Transfer",
            "command_sequence" : [
                                 {
                                    "reg": "0004",
                                    "input_title": "Seconds",
                                    "type": "int",
                                    "length": 2,
                                    "bounds_regex":"^([5-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-2][0-9]{3}|3[0-5][0-9]{2}|3600)$",
                                    "tooltip": "The number of seconds to run once started. This must be a whole number between 5 and 3600"
                                 },
                                 {
                                    "reg": "0003",
                                    "comment": "both 00028 and 0019 appear to support remote start commands",
                                    "value": "0019"
                                 }
                                 ]
         },
        {
            "onewordcommand" : "pzremotestarttransfertest",
            "title" : "Remote Start and Transfer Test",
            "tooltip": "Run the generator with the transfer switch activated for the exercise cycle duration.",
            "command_sequence" : [
                                 {
                                    "reg": "0003",
                                    "comment": "both 00028 and 0019 appear to support remote start commands",
                                    "value": "00028"
                                 }
                                 ]
         },
         
         {
            "onewordcommand" : "exerciseduration",
            "title" : "Exercise Duration",
            "command_sequence" : [
                                   {
                                      "reg": "023e",
                                      "input_title": "Minutes",
                                      "type": "int",
                                      "length": 2,
                                      "bounds_regex":"^(?:[5-9]|[1-5][0-9]|60)$",
                                      "tooltip": "The duration of the exercise cycle. This must be a whole number between 12 and 60 minutes."
                                   }
                                 ]
        },
        {
            "onewordcommand" : "returntoutilitydelay",
            "title" : "Return to Utility Delay",
            "command_sequence" : [
                                   {
                                      "reg": "0255",
                                      "input_title": "Seconds",
                                      "type": "int",
                                      "length": 2,
                                      "bounds_regex":"^(?:1[5-9]|[2-9]\\d|[1-9]\\d{2}|1[0-4]\\d{2}|1500)$",
                                      "tooltip": "The duration in seconds to delay the return to utility once power has been restored. This must be a whole number between 15 and 1500 seconds."
                                   }
                                 ]
        },
        {
            "onewordcommand" : "cooldowntime",
            "title" : "Cool Down Time",
            "command_sequence" : [
                                   {
                                      "reg": "0256",
                                      "input_title": "Seconds",
                                      "type": "int",
                                      "length": 2,
                                      "bounds_regex":"^(?:[6-9]\\d|[12]\\d\\d|300)$",
                                      "tooltip": "The duration in seconds run the generator after the load has been removed. This must be a whole number between 60 and 300 seconds."
                                   }
                                 ]
        }
    ]
}